# Valores de exemplo; configure no runtime do Coolify e não inclua credenciais no Git.
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://<host-interno>:5432/<banco>
DB_USERNAME=<usuario-do-banco>
DB_PASSWORD=<secret-do-banco>
JWT_PRIVATE_KEY_FILE=/run/secrets/iiam-private.pem
JWT_ISSUER=https://<dominio-da-api>
JWT_AUDIENCE=imarui-iam
APP_BASE_URL=https://<dominio-da-api>
AUTH_ALLOWED_ORIGINS=https://<origem-do-frontend>
AUTH_REQUIRE_HTTPS=true
AUTH_COOKIE_SAME_SITE=Lax
MANAGEMENT_HEALTH_REDIS_ENABLED=false
# SMTP e frontend para mensagens serão configurados posteriormente.
# Proxy: não ativar forwarded headers antes de restringir e validar os proxies reais.
